{
	"name": "n8n-nodes-openclaw-weixin",
	"version": "0.2.0",
	"description": "Weixin iLink nodes for n8n",
	"license": "MIT",
	"homepage": "https://github.com/ZHA30/n8n-nodes-openclaw-weixin",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "ZHA30",
		"email": "115915443+ZHA30@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ZHA30/n8n-nodes-openclaw-weixin.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs"
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/WeixinApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WeixinChatTrigger/WeixinChatTrigger.node.js",
			"dist/nodes/WeixinChat/WeixinChat.node.js",
			"dist/nodes/Weixin/Weixin.node.js",
			"dist/nodes/WeixinTrigger/WeixinTrigger.node.js",
			"dist/nodes/WeixinLoginTrigger/WeixinLoginTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.57.3",
		"@types/qrcode": "1.5.6",
		"eslint": "9.32.0",
		"n8n-workflow": "2.47.2",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"lossless-json": "4.3.3",
		"qrcode": "1.5.4"
	}
}
